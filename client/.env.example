# Leave REACT_APP_API_URL empty.
#  - In development, src/setupProxy.js sends /api to your local server (http://localhost:5000).
#  - On Vercel, vercel.json sends /api to your server.
#  - If the server also serves the website (single-host deploy), /api is on the same domain, so keep it empty.
# Set it only when the browser must call the API on another domain directly, e.g. https://api.example.com/api
REACT_APP_API_URL=

# Development only: test against a live server instead of your local one.
# REACT_APP_PROXY_TARGET=https://your-api.onrender.com
