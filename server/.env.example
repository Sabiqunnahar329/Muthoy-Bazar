PORT=5000

# Use the SAME database name here, in server/.env and in Render, or Render will read an empty database.
# Put your own user and password. Never commit the real values to GitHub.
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.xxxxx.mongodb.net/muthoy_bazar?retryWrites=true&w=majority
JWT_SECRET=put-a-long-random-text-here
CLIENT_URL=http://localhost:3000

# First admin account, created by `npm run seed`
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@muthoybazar.com
ADMIN_PASSWORD=choose-a-strong-password

# SMS (optional). Without a token, SMS messages are printed to the server console.
SMS_PROVIDER=greenweb
SMS_TOKEN=

# Set to 1 when the server runs behind a proxy such as Render
TRUST_PROXY=
